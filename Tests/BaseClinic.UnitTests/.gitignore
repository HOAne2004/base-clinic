# ================================
# .NET / C# Gitignore Standard
# ================================

# Build folders
[Bb]in/
[Oo]bj/
[Aa]rtifacts/

# Visual Studio user files and options
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code workspace files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Diagnostics / Test results
[Tt]est[Rr]esults/
*.trx
*.xml